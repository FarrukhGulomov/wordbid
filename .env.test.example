# Copy to .env.test before running `npm test`.
# The database name MUST contain "test" — the suite refuses to run otherwise.
DATABASE_URL="postgresql://user:password@localhost:5432/owntheinternet_test?schema=public"
PAYMENT_PROVIDER="mock"
CLICK_HASH_SALT="test-salt"
ADMIN_TOKEN="test-admin-token"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
STARTING_PRICE_CENTS="1000"
TAKEOVER_INCREMENT_PERCENT="5"
