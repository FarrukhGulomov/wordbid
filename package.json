{
  "name": "owntheinternet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "reconcile-refunds": "tsx scripts/reconcile-refunds.ts",
    "remove-seed-owners": "tsx scripts/remove-seed-owners.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "stripe": "18.5.0",
    "undici": "8.10.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.28",
    "prisma": "6.16.2",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "sharp": "0.35.4",
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.1",
    "postcss": "8.5.28"
  }
}
