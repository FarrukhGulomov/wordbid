# --- Database (required) ---
DATABASE_URL="postgresql://user:password@localhost:5432/owntheinternet?schema=public"

# --- Payments ---
# "mock"   -> no external service; checkout confirms via a local sandbox page. Dev only.
# "stripe" -> real Stripe Checkout. Requires the three STRIPE_* vars below.
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="usd"

# --- Security (required in production) ---
# Salt for hashing visitor IP+UA in click tracking. Any long random string.
CLICK_HASH_SALT="change-me-to-a-long-random-string"
# Bearer token guarding /admin.
ADMIN_TOKEN="change-me-to-a-long-random-string"

# --- Product configuration ---
# Price to claim an unowned word, in cents. Default $10.
STARTING_PRICE_CENTS="1000"
# Minimum takeover premium over the current value, in percent. Default 5%.
TAKEOVER_INCREMENT_PERCENT="5"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
